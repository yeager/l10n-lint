#: l10n_lint.py:245
#, python-brace-format
msgid "Could not read file: {error}"
msgstr "ファイルを読み込めませんでした: {error}"

#: l10n_lint.py:262
#, python-brace-format
msgid "Unknown file format: {ext}"
msgstr "不明なファイル形式: {ext}"

#: l10n_lint.py:289
msgid "Missing translation (empty msgstr)"
msgstr "翻訳がありません（空のmsgstr ）"

#: l10n_lint.py:300
msgid "Fuzzy translation needs review"
msgstr "あいまいな翻訳にはレビューが必要です"

#: l10n_lint.py:319
#, python-brace-format
msgid "Duplicate msgid (first seen at line {line})"
msgstr "Msgidを複製({line}行目に最初に表示)"

#: l10n_lint.py:342
msgid "Unfinished/missing translation"
msgstr "未完成/欠落している翻訳"

#: l10n_lint.py:353
msgid "Vanished translation (source removed)"
msgstr "消えた翻訳（ソースが削除されました）"

#: l10n_lint.py:382
#, python-brace-format
msgid "Placeholder mismatch ({name}): source has {source}, translation has {trans}"
msgstr "プレースホルダーの不一致（{ name }）：ソースには{source}があり、翻訳には{trans}があります"

#: l10n_lint.py:396
#, python-brace-format
msgid "Translation is very long ({length} chars, max {max})"
msgstr "翻訳が非常に長い（{ length}文字、最大{max }）"

#: l10n_lint.py:408
#, python-brace-format
msgid "Translation is {ratio:.1f}x longer than source"
msgstr "翻訳はソースよりも{ratio :.1 f}倍長くなっています"

#: l10n_lint.py:489
#, python-brace-format
msgid "Warning: Could not fetch {path}: {error}"
msgstr "警告: {path}を取得できませんでした: {error}"

#: l10n_lint.py:512
#, python-brace-format
msgid "✅ {count} file(s) checked, no issues found."
msgstr "✅ {count}個のファイルがチェックされました。問題は見つかりませんでした。"

#: l10n_lint.py:523
#, python-brace-format
msgid "  {icon} Line {line}: [{rule}] {message}"
msgstr "{icon}行{line }：[{ rule}] {message}"

#: l10n_lint.py:527
#, python-brace-format
msgid "     Context: \"{context}...\""
msgstr "    Context context;"

#: l10n_lint.py:529
#, python-brace-format
msgid "\n📊 Summary: {files} file(s), {errors} error(s), {warnings} warning(s)"
msgstr "\n📊 概要：{ files}ファイル、{errors}エラー、{warnings}警告"

#: l10n_lint.py:537
msgid "l10n-lint - Linter for localization files (.po, .ts)"
msgstr "l10n-lint - ローカライズファイル用リンター (.po, .ts)"

#: l10n_lint.py:539
msgid "\nExamples:\n  l10n-lint ./translations/           # Lint local directory\n  l10n-lint file.po                   # Lint single file\n  l10n-lint --github owner/repo       # Lint GitHub repository\n  l10n-lint --github https://github.com/owner/repo --path resources/language/\n        "
msgstr "\n例：\n  l 10 n - lint ./ translations /# Lintローカルディレクトリ\n  l10n-lint file.po # Lintシングルファイル\n  l 10 n - lint -- github owner/repo # Lint GitHubリポジトリ\n  l 10 n - lint -- github https://github.com/owner/repo -- path resources/language/"

#: l10n_lint.py:548
msgid "Files or directories to lint"
msgstr "リントするファイルまたはディレクトリ"

#: l10n_lint.py:549
msgid "GitHub repository (owner/repo or URL)"
msgstr "GitHubリポジトリ (owner/repo または URL)"

#: l10n_lint.py:550
msgid "Path filter for GitHub repos"
msgstr "GitHubリポジトリのパスフィルタ"

#: l10n_lint.py:551
msgid "Output format"
msgstr "出力形式"

#: l10n_lint.py:552
msgid "Max translation length (default: 500)"
msgstr "最大翻訳長 (デフォルト: 500)"

#: l10n_lint.py:553
msgid "Don't search subdirectories"
msgstr "サブディレクトリを検索しない"

#: l10n_lint.py:554
msgid "Treat warnings as errors"
msgstr "警告をエラーとして扱う"

#: l10n_lint.py:571
#, python-brace-format
msgid "🔍 Fetching from GitHub: {repo}"
msgstr "GitHubから🔍取得中: {repo}"

#: l10n_lint.py:574
#, python-brace-format
msgid "  Checking: {path}"
msgstr "確認中：{ path}"

#: l10n_lint.py:579
#, python-brace-format
msgid "❌ GitHub error: {error}"
msgstr "❌ GitHubエラー: {error}"
