#: l10n_lint.py:254
#, python-brace-format
msgid "Could not read file: {error}"
msgstr "Kunde inte läsa filen: {error}"

#: l10n_lint.py:271
#, python-brace-format
msgid "Unknown file format: {ext}"
msgstr "Okänt filformat: {ext}"

#: l10n_lint.py:306 l10n_lint.py:317
msgid "Missing translation (empty msgstr)"
msgstr "Översättning saknas (tom msgstr)"

#: l10n_lint.py:328
msgid "Fuzzy translation needs review"
msgstr "Fuzzy-översättning behöver granskas"

#: l10n_lint.py:347
#, python-brace-format
msgid "Duplicate msgid (first seen at line {line})"
msgstr "Duplicerad msgid (först sedd på rad {line})"

#: l10n_lint.py:370
msgid "Unfinished/missing translation"
msgstr "Oavslutad/saknad översättning"

#: l10n_lint.py:381
msgid "Vanished translation (source removed)"
msgstr "Försvunnen översättning (källan borttagen)"

#: l10n_lint.py:410
#, python-brace-format
msgid ""
"Placeholder mismatch ({name}): source has {source}, translation has {trans}"
msgstr ""
"Platshållare stämmer inte ({name}): källan har {source}, översättningen har "
"{trans}"

#: l10n_lint.py:425
#, python-brace-format
msgid "Translation is very long ({length} chars, max {max})"
msgstr "Översättningen är mycket lång ({length} tecken, max {max})"

#: l10n_lint.py:437
#, python-brace-format
msgid "Translation is {ratio:.1f}x longer than source"
msgstr "Översättningen är {ratio:.1f}x längre än källan"

#: l10n_lint.py:518
#, python-brace-format
msgid "Warning: Could not fetch {path}: {error}"
msgstr "Varning: Kunde inte hämta {path}: {error}"

#: l10n_lint.py:541
#, python-brace-format
msgid "✅ {count} file(s) checked, no issues found."
msgstr "✅ {count} fil(er) granskade, inga problem hittades."

#: l10n_lint.py:552
#, python-brace-format
msgid "  {icon} Line {line}: [{rule}] {message}"
msgstr "  {icon} Rad {line}: [{rule}] {message}"

#: l10n_lint.py:556
#, python-brace-format
msgid "     Context: \"{context}...\""
msgstr "     Kontext: \"{context}...\""

#: l10n_lint.py:558
#, python-brace-format
msgid ""
"\n"
"📊 Summary: {files} file(s), {errors} error(s), {warnings} warning(s)"
msgstr ""
"\n"
"📊 Sammanfattning: {files} fil(er), {errors} fel, {warnings} varning(ar)"

#: l10n_lint.py:566
msgid "l10n-lint - Linter for localization files (.po, .ts)"
msgstr "l10n-lint - Linter för lokaliseringsfiler (.po, .ts)"

#: l10n_lint.py:568
msgid ""
"\n"
"Examples:\n"
"  l10n-lint ./translations/           # Lint local directory\n"
"  l10n-lint file.po                   # Lint single file\n"
"  l10n-lint --github owner/repo       # Lint GitHub repository\n"
"  l10n-lint --github https://github.com/owner/repo --path resources/"
"language/\n"
"        "
msgstr ""
"\n"
"Exempel:\n"
"  l10n-lint ./translations/           # Granska lokal katalog\n"
"  l10n-lint fil.po                    # Granska enskild fil\n"
"  l10n-lint --github ägare/repo       # Granska GitHub-arkiv\n"
"  l10n-lint --github https://github.com/ägare/repo --path resources/"
"language/\n"
"        "

#: l10n_lint.py:577
msgid "Files or directories to lint"
msgstr "Filer eller kataloger att granska"

#: l10n_lint.py:578
msgid "GitHub repository (owner/repo or URL)"
msgstr "GitHub-arkiv (ägare/repo eller URL)"

#: l10n_lint.py:579
msgid "Path filter for GitHub repos"
msgstr "Sökvägsfilter för GitHub-arkiv"

#: l10n_lint.py:580
msgid "Output format"
msgstr "Utdataformat"

#: l10n_lint.py:581
msgid "Max translation length (default: 500)"
msgstr "Max översättningslängd (standard: 500)"

#: l10n_lint.py:582
msgid "Don't search subdirectories"
msgstr "Sök inte i underkataloger"

#: l10n_lint.py:583
msgid "Treat warnings as errors"
msgstr "Behandla varningar som fel"

#: l10n_lint.py:584
msgid "Show only summary"
msgstr "Visa endast sammanfattning"

#: l10n_lint.py:585
msgid "Exit code only, no output (for CI)"
msgstr "Endast returkod, ingen utdata (för CI)"

#: l10n_lint.py:586
msgid "Ignore fuzzy warnings"
msgstr "Ignorera luddiga varningar"

#: l10n_lint.py:587
msgid "Show detailed progress"
msgstr "Visa detaljerad förlopp"

#: l10n_lint.py:607
#, python-brace-format
msgid "⏱️  Elapsed time: {elapsed:.2f}s"
msgstr "⏱️  Förfluten tid: {elapsed:.2f}s"

#: l10n_lint.py:609
#, python-brace-format
msgid "🔧 l10n-lint {version} starting..."
msgstr "🔧 l10n-lint {version} startar..."

#: l10n_lint.py:610
#, python-brace-format
msgid "   Max length: {max}"
msgstr "   Max längd: {max}"

#: l10n_lint.py:611
#, python-brace-format
msgid "   Length ratio: {ratio}x"
msgstr "   Längdförhållande: {ratio}x"

#: l10n_lint.py:612
#, python-brace-format
msgid "   Strict mode: {strict}"
msgstr "   Strikt läge: {strict}"

#: l10n_lint.py:613
#, fuzzy, python-brace-format
msgid "   Output format: {fmt}"
msgstr "Utdataformat"

#: l10n_lint.py:614
#, python-brace-format
msgid "   Recursive: {rec}"
msgstr "   Rekursiv: {rec}"

#: l10n_lint.py:616
#, python-brace-format
msgid "   Locale dir: {dir}"
msgstr "   Lokalkatalog: {dir}"

#: l10n_lint.py:617
#, python-brace-format
msgid "   Language: {lang}"
msgstr "   Språk: {lang}"

#: l10n_lint.py:619
msgid "   Locale: not found (using English)"
msgstr "   Lokal: hittades inte (använder engelska)"

#: l10n_lint.py:630
msgid "🌐 GitHub mode"
msgstr "🌐 GitHub-läge"

#: l10n_lint.py:631
#, python-brace-format
msgid "🔍 Fetching from GitHub: {repo}"
msgstr "🔍 Hämtar från GitHub: {repo}"

#: l10n_lint.py:633
#, fuzzy, python-brace-format
msgid "   Path filter: {path}"
msgstr "  Granskar: {path}"

#: l10n_lint.py:636
msgid "   Connecting to GitHub API..."
msgstr "   Ansluter till GitHub API..."

#: l10n_lint.py:641 l10n_lint.py:675
#, fuzzy, python-brace-format
msgid "  [{n}] {path}"
msgstr "  Granskar: {path}"

#: l10n_lint.py:642 l10n_lint.py:676
#, python-brace-format
msgid "       Size: {size} bytes"
msgstr "       Storlek: {size} byte"

#: l10n_lint.py:647 l10n_lint.py:681
#, python-brace-format
msgid "       Parsed in {elapsed:.3f}s"
msgstr "       Tolkad på {elapsed:.3f}s"

#: l10n_lint.py:649 l10n_lint.py:683
#, python-brace-format
msgid "       ⚠️  Found {count} issue(s)"
msgstr "       ⚠️  Hittade {count} problem"

#: l10n_lint.py:651 l10n_lint.py:685
msgid "       ✓ No issues"
msgstr "       ✓ Inga problem"

#: l10n_lint.py:653
#, python-brace-format
msgid "   Fetched {count} file(s) in {elapsed:.2f}s"
msgstr "   Hämtade {count} fil(er) på {elapsed:.2f}s"

#: l10n_lint.py:656
#, python-brace-format
msgid "❌ GitHub error: {error}"
msgstr "❌ GitHub-fel: {error}"

#: l10n_lint.py:661
msgid "📁 Local mode"
msgstr "📁 Lokalt läge"

#: l10n_lint.py:664
#, fuzzy, python-brace-format
msgid "📂 Scanning: {path}"
msgstr "  Granskar: {path}"

#: l10n_lint.py:668
#, python-brace-format
msgid "   Found {count} file(s) in {elapsed:.3f}s"
msgstr "   Hittade {count} fil(er) på {elapsed:.3f}s"

#: l10n_lint.py:687
#, python-brace-format
msgid "   Total local files: {count}"
msgstr "   Totalt lokala filer: {count}"

#: l10n_lint.py:695
msgid "📊 Summary:"
msgstr "📊 Sammanfattning:"

#: l10n_lint.py:696
#, python-brace-format
msgid "   Files checked: {count}"
msgstr "   Granskade filer: {count}"

#: l10n_lint.py:697
#, python-brace-format
msgid "   Errors: {count}"
msgstr "   Fel: {count}"

#: l10n_lint.py:698
#, python-brace-format
msgid "   Warnings: {count}"
msgstr "   Varningar: {count}"

#: l10n_lint.py:700
#, python-brace-format
msgid "   Fuzzy: {count}"
msgstr "   Fuzzy: {count}"

#: l10n_lint.py:702
#, python-brace-format
msgid "   Missing: {count}"
msgstr "   Saknade: {count}"

#: l10n_lint.py:704
#, python-brace-format
msgid "   Placeholder mismatches: {count}"
msgstr "   Platshållarmissmatch: {count}"

#: l10n_lint.py:712
#, fuzzy, python-brace-format
msgid "📊 {files} file(s), {errors} error(s), {warnings} warning(s)"
msgstr "📊 {files} fil(er), {errors} fel, {warnings} varning(ar)"
"\n"
"📊 Sammanfattning: {files} fil(er), {errors} fel, {warnings} varning(ar)"
