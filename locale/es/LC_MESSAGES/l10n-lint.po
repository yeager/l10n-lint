#: l10n_lint.py:566
msgid "l10n-lint - Linter for localization files (.po, .ts)"
msgstr "l10n-lint - Linter para archivos de localización (.po, .ts)"

#: l10n_lint.py:568
msgid ""
"\n"
"Examples:\n"
"  l10n-lint ./translations/           # Lint local directory\n"
"  l10n-lint file.po                   # Lint single file\n"
"  l10n-lint --github owner/repo       # Lint GitHub repository\n"
"  l10n-lint --github https://github.com/owner/repo --path resources/"
"language/\n"
"        "
msgstr ""
"\n"
"Ejemplos:\n"
"  l10n-lint ./translations/           # Verificar directorio local\n"
"  l10n-lint file.po                   # Verificar archivo único\n"
"  l10n-lint --github owner/repo       # Verificar repositorio GitHub\n"
"  l10n-lint --github https://github.com/owner/repo --path resources/"
"language/\n"
"        "

