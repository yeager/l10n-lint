#: l10n_lint.py:245
#, python-brace-format
msgid "Could not read file: {error}"
msgstr "Не удалось прочитать файл: {error}"

#: l10n_lint.py:262
#, python-brace-format
msgid "Unknown file format: {ext}"
msgstr "Неизвестный формат файла: {ext}"

#: l10n_lint.py:289
msgid "Missing translation (empty msgstr)"
msgstr "Отсутствует перевод (пусто msgstr)"

#: l10n_lint.py:300
msgid "Fuzzy translation needs review"
msgstr "Нечеткий перевод нуждается в проверке"

#: l10n_lint.py:319
#, python-brace-format
msgid "Duplicate msgid (first seen at line {line})"
msgstr "Дублировать msgid (впервые видно в строке {line})"

#: l10n_lint.py:342
msgid "Unfinished/missing translation"
msgstr "Незаконченный/отсутствующий перевод"

#: l10n_lint.py:353
msgid "Vanished translation (source removed)"
msgstr "Исчез перевод (источник удален)"

#: l10n_lint.py:382
#, python-brace-format
msgid "Placeholder mismatch ({name}): source has {source}, translation has {trans}"
msgstr "Несоответствие заполнителя ({name}): источник имеет {source}, перевод имеет {trans}"

#: l10n_lint.py:396
#, python-brace-format
msgid "Translation is very long ({length} chars, max {max})"
msgstr "Перевод очень длинный ({length} символов, max {max})"

#: l10n_lint.py:408
#, python-brace-format
msgid "Translation is {ratio:.1f}x longer than source"
msgstr "Перевод {ratio:.1f}x длиннее, чем исходный"

#: l10n_lint.py:489
#, python-brace-format
msgid "Warning: Could not fetch {path}: {error}"
msgstr "Предупреждение: не удалось получить {path}: {error}"

#: l10n_lint.py:512
#, python-brace-format
msgid "✅ {count} file(s) checked, no issues found."
msgstr "Проверено файлов: ✅ {count}. Проблем не найдено."

#: l10n_lint.py:523
#, python-brace-format
msgid "  {icon} Line {line}: [{rule}] {message}"
msgstr "{icon} Строка {line}: [{rule}] {message}"

#: l10n_lint.py:527
#, python-brace-format
msgid "     Context: \"{context}...\""
msgstr "Context: \"{context}...\""

#: l10n_lint.py:529
#, python-brace-format
msgid "\n📊 Summary: {files} file(s), {errors} error(s), {warnings} warning(s)"
msgstr "\n📊 Сводка: {files} файлов, {errors} ошибок, {warnings} предупреждений"

#: l10n_lint.py:537
msgid "l10n-lint - Linter for localization files (.po, .ts)"
msgstr "l10n-lint - LINTER для файлов локализации (.po, .ts)"

#: l10n_lint.py:539
msgid "\nExamples:\n  l10n-lint ./translations/           # Lint local directory\n  l10n-lint file.po                   # Lint single file\n  l10n-lint --github owner/repo       # Lint GitHub repository\n  l10n-lint --github https://github.com/owner/repo --path resources/language/\n        "
msgstr "\nПримеры:\n  l10n-lint ./translations/           # Локальный каталог Lint\n  l10n-lint file.po                   # Один файл Lint\n  l10n-lint --github owner/repo       # GitHub репозиторий Lint\n  l10n-lint --github https://github.com/owner/repo --path resources/language/"

#: l10n_lint.py:548
msgid "Files or directories to lint"
msgstr "Файлы или каталоги для lint"

#: l10n_lint.py:549
msgid "GitHub repository (owner/repo or URL)"
msgstr "Репозиторий GitHub (владелец/репозиторий или URL)"

#: l10n_lint.py:550
msgid "Path filter for GitHub repos"
msgstr "Фильтр путей для репозиториев GitHub"

#: l10n_lint.py:551
msgid "Output format"
msgstr "Формат вывода"

#: l10n_lint.py:552
msgid "Max translation length (default: 500)"
msgstr "Максимальная длина перевода (по умолчанию: 500)"

#: l10n_lint.py:553
msgid "Don't search subdirectories"
msgstr "Не искать в подкаталогах"

#: l10n_lint.py:554
msgid "Treat warnings as errors"
msgstr "Относитесь к предупреждениям как к ошибкам"

#: l10n_lint.py:571
#, python-brace-format
msgid "🔍 Fetching from GitHub: {repo}"
msgstr "🔍 Получение с GitHub: {repo}"

#: l10n_lint.py:574
#, python-brace-format
msgid "  Checking: {path}"
msgstr "Проверка пути"

#: l10n_lint.py:579
#, python-brace-format
msgid "❌ GitHub error: {error}"
msgstr "Ошибка ❌ GitHub: {error}"
