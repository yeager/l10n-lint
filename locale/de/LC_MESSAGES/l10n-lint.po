#: l10n_lint.py:253
#, python-brace-format
msgid "Could not read file: {error}"
msgstr "Datei konnte nicht gelesen werden: {error}"

#: l10n_lint.py:270
#, python-brace-format
msgid "Unknown file format: {ext}"
msgstr "Unbekanntes Dateiformat: {ext}"

#: l10n_lint.py:305 l10n_lint.py:316
msgid "Missing translation (empty msgstr)"
msgstr "Fehlende Übersetzung (leere msgstr)"

#: l10n_lint.py:327
msgid "Fuzzy translation needs review"
msgstr "Fuzzy-Übersetzung muss überprüft werden"

#: l10n_lint.py:346
#, python-brace-format
msgid "Duplicate msgid (first seen at line {line})"
msgstr "Doppelte msgstr (zuerst in Zeile {line} gesehen)"

#: l10n_lint.py:369
msgid "Unfinished/missing translation"
msgstr "Unfertige/fehlende Übersetzung"

#: l10n_lint.py:380
msgid "Vanished translation (source removed)"
msgstr "Verschwundene Übersetzung (Quelle entfernt)"

#: l10n_lint.py:409
#, python-brace-format
msgid ""
"Placeholder mismatch ({name}): source has {source}, translation has {trans}"
msgstr ""
"Platzhalter stimmt nicht überein ({name}): Quelle hat {source}, Übersetzung "
"hat {trans}"

#: l10n_lint.py:424
#, python-brace-format
msgid "Translation is very long ({length} chars, max {max})"
msgstr "Übersetzung ist sehr lang ({length} Zeichen, max {max})"

#: l10n_lint.py:436
#, python-brace-format
msgid "Translation is {ratio:.1f}x longer than source"
msgstr "Übersetzung ist {ratio:.1f}x länger als Quelle"

#: l10n_lint.py:517
#, python-brace-format
msgid "Warning: Could not fetch {path}: {error}"
msgstr "Warnung: {path} konnte nicht abgerufen werden: {error}"

#: l10n_lint.py:540
#, python-brace-format
msgid "✅ {count} file(s) checked, no issues found."
msgstr "✅ {count} Datei(en) überprüft, keine Probleme gefunden."

#: l10n_lint.py:551
#, python-brace-format
msgid "  {icon} Line {line}: [{rule}] {message}"
msgstr "{icon} Zeile {line}: [{rule}] {message}"

#: l10n_lint.py:555
#, python-brace-format
msgid "     Context: \"{context}...\""
msgstr "\"context\" = \"Kontext\";"

#: l10n_lint.py:557
#, python-brace-format
msgid ""
"\n"
"📊 Summary: {files} file(s), {errors} error(s), {warnings} warning(s)"
msgstr ""
"\n"
"📊 Zusammenfassung: {files} Datei(en), {errors} Fehler, {warnings} "
"Warnung(en)"

#: l10n_lint.py:565
msgid "l10n-lint - Linter for localization files (.po, .ts)"
msgstr "l10n-lint - Linter für Lokalisierungsdateien (.po, .ts)"

#: l10n_lint.py:567
msgid ""
"\n"
"Examples:\n"
"  l10n-lint ./translations/           # Lint local directory\n"
"  l10n-lint file.po                   # Lint single file\n"
"  l10n-lint --github owner/repo       # Lint GitHub repository\n"
"  l10n-lint --github https://github.com/owner/repo --path resources/"
"language/\n"
"        "
msgstr ""
"\n"
"Beispiele:\n"
"  l10n-lint ./translations/           # Lokales Verzeichnis linten\n"
"  l10n-lint file.po                   # Einzelne Datei linten\n"
"  l10n-lint --github owner/repo       # GitHub-Repository linten\n"
"  l10n-lint --github https://github.com/owner/repo --path resources/"
"language/\n"
"        "

#: l10n_lint.py:576
msgid "Files or directories to lint"
msgstr "Dateien oder Verzeichnisse zu Lint"

#: l10n_lint.py:577
msgid "GitHub repository (owner/repo or URL)"
msgstr "GitHub-Repository (Eigentümer/Repo oder URL)"

#: l10n_lint.py:578
msgid "Path filter for GitHub repos"
msgstr "Pfadfilter für GitHub-Repos"

#: l10n_lint.py:579
msgid "Output format"
msgstr "Ausgabeformat"

#: l10n_lint.py:580
msgid "Max translation length (default: 500)"
msgstr "Max. Übersetzungslänge (Standard: 500)"

#: l10n_lint.py:581
msgid "Don't search subdirectories"
msgstr "Unterverzeichnisse nicht durchsuchen"

#: l10n_lint.py:582
msgid "Treat warnings as errors"
msgstr "Warnungen als Fehler behandeln"

#: l10n_lint.py:599
#, python-brace-format
msgid "🔍 Fetching from GitHub: {repo}"
msgstr "🔍 Wird von GitHub abgerufen: {repo}"

#: l10n_lint.py:602
#, python-brace-format
msgid "  Checking: {path}"
msgstr "Prüfung: {path}"

#: l10n_lint.py:607
#, python-brace-format
msgid "❌ GitHub error: {error}"
msgstr "❌ GitHub-Fehler: {error}"
