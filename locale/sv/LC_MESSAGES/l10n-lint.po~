# Argparse section names
msgid "positional arguments"
msgstr "positionsargument"

msgid "options"
msgstr "flaggor"

# Description
msgid "l10n-lint - Linter for localization files (.po, .ts)"
msgstr "l10n-lint - Linter för lokaliseringsfiler (.po, .ts)"

# Epilog examples
msgid ""
"\n"
"Examples:\n"
"  l10n-lint ./translations/           # Lint local directory\n"
"  l10n-lint file.po                   # Lint single file\n"
"  l10n-lint --github owner/repo       # Lint GitHub repository\n"
"  l10n-lint -f html -o report.html .  # Generate HTML report\n"
"  l10n-lint -f json -o results.json . # Generate JSON report\n"
"        "
msgstr ""
"\n"
"Exempel:\n"
"  l10n-lint ./översättningar/         # Granska lokal katalog\n"
"  l10n-lint fil.po                    # Granska enskild fil\n"
"  l10n-lint --github ägare/repo       # Granska GitHub-arkiv\n"
"  l10n-lint -f html -o rapport.html . # Generera HTML-rapport\n"
"  l10n-lint -f json -o resultat.json . # Generera JSON-rapport\n"
"        "

# Arguments
msgid "Files or directories to lint"
msgstr "Filer eller kataloger att granska"

msgid "Lint a GitHub repository (owner/repo)"
msgstr "Granska ett GitHub-arkiv (ägare/repo)"

msgid "Output format"
msgstr "Utdataformat"

msgid "Save report to file"
msgstr "Spara rapport till fil"

msgid "Maximum translation length"
msgstr "Maximal översättningslängd"

msgid "Skip fuzzy warnings"
msgstr "Ignorera luddiga varningar"

msgid "Show verbose progress"
msgstr "Visa detaljerad förlopp"

msgid "Show this help message and exit"
msgstr "Visa detta hjälpmeddelande och avsluta"

msgid "Show version number and exit"
msgstr "Visa versionsnummer och avsluta"

# Error messages
msgid "Could not read file: {error}"
msgstr "Kunde inte läsa fil: {error}"

msgid "Unknown file format: {ext}"
msgstr "Okänt filformat: {ext}"

# Lint rules - messages
msgid "Missing translation (empty msgstr)"
msgstr "Saknad översättning (tom msgstr)"

msgid "Fuzzy translation needs review"
msgstr "Luddig översättning behöver granskas"

msgid "Duplicate msgid (first seen at line {line})"
msgstr "Duplicerad msgid (först sedd på rad {line})"

msgid "Unfinished/missing translation"
msgstr "Ofärdig/saknad översättning"

msgid "Vanished translation (source removed)"
msgstr "Försvunnen översättning (källa borttagen)"

msgid "Placeholder mismatch ({name}): source has {source}, translation has {trans}"
msgstr "Platshållare stämmer inte ({name}): källa har {source}, översättning har {trans}"

msgid "Translation is very long ({length} chars, max {max})"
msgstr "Översättningen är mycket lång ({length} tecken, max {max})"

msgid "Translation is {ratio:.1f}x longer than source"
msgstr "Översättningen är {ratio:.1f}x längre än källan"

msgid "Translation is suspiciously short ({ratio:.1f}x of source)"
msgstr "Översättningen är misstänkt kort ({ratio:.1f}x av källan)"

msgid "Missing ending punctuation (source ends with '{char}')"
msgstr "Saknad avslutande interpunktion (källan slutar med '{char}')"

msgid "Extra ending punctuation (source has none)"
msgstr "Extra avslutande interpunktion (källan har ingen)"

msgid "Source starts with uppercase, translation with lowercase"
msgstr "Källan börjar med versal, översättningen med gemen"

msgid "Translation has trailing whitespace"
msgstr "Översättningen har blanksteg i slutet"

msgid "Translation contains double spaces"
msgstr "Översättningen innehåller dubbla mellanslag"

msgid "Translation has mixed quote styles"
msgstr "Översättningen har blandade citatstilar"

msgid "HTML tags mismatch: source has {source}, translation has {trans}"
msgstr "HTML-taggar stämmer inte: källa har {source}, översättning har {trans}"

msgid "Escape character count mismatch: {details}"
msgstr "Escape-tecken stämmer inte: {details}"

msgid "Keyboard accelerator missing in translation"
msgstr "Tangentbordsgenväg saknas i översättningen"

msgid "Nordic character '{char}' used as keyboard accelerator"
msgstr "Nordiskt tecken '{char}' använt som tangentbordsgenväg"

msgid "Numbers {nums} from source missing in translation"
msgstr "Siffror {nums} från källan saknas i översättningen"

msgid "Translation may contain untranslated English: {words}"
msgstr "Översättningen kan innehålla oöversatt engelska: {words}"

msgid "Repeated word: '{word}'"
msgstr "Upprepat ord: '{word}'"

msgid "Translation is identical to source (possibly untranslated)"
msgstr "Översättningen är identisk med källan (möjligen oöversatt)"

msgid "Option value '{value}' from source not found in translation"
msgstr "Alternativvärde '{value}' från källan hittades inte i översättningen"

# Warnings
msgid "Warning: Could not fetch {path}: {error}"
msgstr "Varning: Kunde inte hämta {path}: {error}"

# Summary messages
msgid "✅ {count} file(s) checked, no issues found."
msgstr "✅ {count} fil(er) granskade, inga problem hittade."

msgid "  {icon} Line {line}: [{rule}] {message}"
msgstr "  {icon} Rad {line}: [{rule}] {message}"

msgid "     Context: \"{context}...\""
msgstr "     Kontext: \"{context}...\""

msgid "📊 Summary: {files} file(s), {errors} error(s), {warnings} warning(s)"
msgstr "📊 Sammanfattning: {files} fil(er), {errors} fel, {warnings} varning(ar)"

msgid "📄 Report saved to: {file}"
msgstr "📄 Rapport sparad till: {file}"

# Verbose output
msgid "🔍 Scanning: {path}"
msgstr "🔍 Skannar: {path}"

msgid "📂 Found {count} file(s) to check"
msgstr "📂 Hittade {count} fil(er) att granska"

msgid "📁 {file}"
msgstr "📁 {file}"

msgid "⚙️ Configuration:"
msgstr "⚙️ Konfiguration:"

msgid "   Max length: {max}"
msgstr "   Maxlängd: {max}"

msgid "   Skip fuzzy: {skip}"
msgstr "   Hoppa över fuzzy: {skip}"

# HTML report
msgid "l10n-lint Report"
msgstr "l10n-lint-rapport"

msgid "Files Checked"
msgstr "Granskade filer"

msgid "Errors"
msgstr "Fel"

msgid "Warnings"
msgstr "Varningar"

msgid "Info"
msgstr "Info"

msgid "Issues by Rule"
msgstr "Problem per regel"

msgid "Rule"
msgstr "Regel"

msgid "Count"
msgstr "Antal"

msgid "Issues by File"
msgstr "Problem per fil"

msgid "File"
msgstr "Fil"

msgid "All Issues"
msgstr "Alla problem"

msgid "Severity"
msgstr "Allvarlighet"

msgid "Line"
msgstr "Rad"

msgid "Message"
msgstr "Meddelande"

msgid "Context"
msgstr "Kontext"
