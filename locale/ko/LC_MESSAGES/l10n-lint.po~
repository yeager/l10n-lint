#: l10n_lint.py:253
#, python-brace-format
msgid "Could not read file: {error}"
msgstr "파일을 읽을 수 없음: {error}"

#: l10n_lint.py:270
#, python-brace-format
msgid "Unknown file format: {ext}"
msgstr "알 수 없는 파일 형식: {ext}"

#: l10n_lint.py:305 l10n_lint.py:316
msgid "Missing translation (empty msgstr)"
msgstr "번역 누락 (빈 msgstr)"

#: l10n_lint.py:327
msgid "Fuzzy translation needs review"
msgstr "퍼지 번역 검토 필요"

#: l10n_lint.py:346
#, python-brace-format
