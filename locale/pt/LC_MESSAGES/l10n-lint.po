#: l10n_lint.py:245
#, python-brace-format
msgid "Could not read file: {error}"
msgstr "Não foi possível ler o ficheiro: {error}"

#: l10n_lint.py:262
#, python-brace-format
msgid "Unknown file format: {ext}"
msgstr "Formato de ficheiro desconhecido: {ext}"

#: l10n_lint.py:289
msgid "Missing translation (empty msgstr)"
msgstr "Tradução ausente (msgstr vazio)"

#: l10n_lint.py:300
msgid "Fuzzy translation needs review"
msgstr "A tradução difusa precisa de revisão"

#: l10n_lint.py:319
#, python-brace-format
msgid "Duplicate msgid (first seen at line {line})"
msgstr "Duplicar msgid (visto pela primeira vez na linha {line})"

#: l10n_lint.py:342
msgid "Unfinished/missing translation"
msgstr "Tradução inacabada/ausente"

#: l10n_lint.py:353
msgid "Vanished translation (source removed)"
msgstr "Tradução desaparecida (fonte removida)"

#: l10n_lint.py:382
#, python-brace-format
msgid "Placeholder mismatch ({name}): source has {source}, translation has {trans}"
msgstr "Incompatibilidade de espaço reservado ({name}): a fonte tem {source}, a tradução tem {trans}"

#: l10n_lint.py:396
#, python-brace-format
msgid "Translation is very long ({length} chars, max {max})"
msgstr "A tradução é muito longa ({length} caracteres, max {max})"

#: l10n_lint.py:408
#, python-brace-format
msgid "Translation is {ratio:.1f}x longer than source"
msgstr "A tradução é {ratio:.1f}x mais longa que a fonte"

#: l10n_lint.py:489
#, python-brace-format
msgid "Warning: Could not fetch {path}: {error}"
msgstr "Aviso: Não foi possível obter {path}: {error}"

#: l10n_lint.py:512
#, python-brace-format
msgid "✅ {count} file(s) checked, no issues found."
msgstr "✅ {count} arquivo(s) verificado (s), nenhum problema encontrado."

#: l10n_lint.py:523
#, python-brace-format
msgid "  {icon} Line {line}: [{rule}] {message}"
msgstr "{icon} Linha {line}: [{rule}] {message}"

#: l10n_lint.py:527
#, python-brace-format
msgid "     Context: \"{context}...\""
msgstr "Contexto: \"{context}...\""

#: l10n_lint.py:529
#, python-brace-format
msgid "\n📊 Summary: {files} file(s), {errors} error(s), {warnings} warning(s)"
msgstr "\n📊 Resumo: {files} arquivo(s), {errors} erro(s), {warnings} aviso(s)"

#: l10n_lint.py:537
msgid "l10n-lint - Linter for localization files (.po, .ts)"
msgstr "l10n-lint - Linter para arquivos de localização (.po, .ts)"

#: l10n_lint.py:539
msgid "\nExamples:\n  l10n-lint ./translations/           # Lint local directory\n  l10n-lint file.po                   # Lint single file\n  l10n-lint --github owner/repo       # Lint GitHub repository\n  l10n-lint --github https://github.com/owner/repo --path resources/language/\n        "
msgstr "\nExemplos:\n  l10n-lint ./translations/           # Diretório local de fiapos\n  l10n-lint file.po                   # Lint ficheiro único\n  l10n-lint --github owner/repo       # Lint Repositório do GitHub\n  l10n-lint --github https://github.com/owner/repo --path resources/language/"

#: l10n_lint.py:548
msgid "Files or directories to lint"
msgstr "Ficheiros ou diretórios para fiapos"

#: l10n_lint.py:549
msgid "GitHub repository (owner/repo or URL)"
msgstr "Repositório do GitHub (proprietário/repositório ou URL)"

#: l10n_lint.py:550
msgid "Path filter for GitHub repos"
msgstr "Filtro de caminho para repositórios do GitHub"

#: l10n_lint.py:551
msgid "Output format"
msgstr "Formato de saída"

#: l10n_lint.py:552
msgid "Max translation length (default: 500)"
msgstr "Comprimento máximo de tradução (padrão: 500)"

#: l10n_lint.py:553
msgid "Don't search subdirectories"
msgstr "Não pesquisar subdiretórios"

#: l10n_lint.py:554
msgid "Treat warnings as errors"
msgstr "Tratar avisos como erros"

#: l10n_lint.py:571
#, python-brace-format
msgid "🔍 Fetching from GitHub: {repo}"
msgstr "🔍 Obtenção do GitHub: {repo}"

#: l10n_lint.py:574
#, python-brace-format
msgid "  Checking: {path}"
msgstr "A verificar: {path}"

#: l10n_lint.py:579
#, python-brace-format
msgid "❌ GitHub error: {error}"
msgstr "Erro ❌ do GitHub: {error}"
