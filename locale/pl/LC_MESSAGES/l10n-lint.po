#: l10n_lint.py:245
#, python-brace-format
msgid "Could not read file: {error}"
msgstr "Nie można odczytać pliku: {error}"

#: l10n_lint.py:262
#, python-brace-format
msgid "Unknown file format: {ext}"
msgstr "Nieznany format pliku: {ext}"

#: l10n_lint.py:289
msgid "Missing translation (empty msgstr)"
msgstr "Brakujące tłumaczenie (pusty msgstr)"

#: l10n_lint.py:300
msgid "Fuzzy translation needs review"
msgstr "Fuzzy translation needs review"

#: l10n_lint.py:319
#, python-brace-format
msgid "Duplicate msgid (first seen at line {line})"
msgstr "Duplikat msgid (pierwszy raz widziany na linii {line})"

#: l10n_lint.py:342
msgid "Unfinished/missing translation"
msgstr "Niedokończone/brakujące tłumaczenie"

#: l10n_lint.py:353
msgid "Vanished translation (source removed)"
msgstr "Zniknięte tłumaczenie (źródło usunięte)"

#: l10n_lint.py:382
#, python-brace-format
msgid "Placeholder mismatch ({name}): source has {source}, translation has {trans}"
msgstr "Niezgodność symboli zastępczych ({name}): źródło ma {source}, tłumaczenie ma {trans}"

#: l10n_lint.py:396
#, python-brace-format
msgid "Translation is very long ({length} chars, max {max})"
msgstr "Tłumaczenie jest bardzo długie ({length} znaków, maks. {max})"

#: l10n_lint.py:408
#, python-brace-format
msgid "Translation is {ratio:.1f}x longer than source"
msgstr "Tłumaczenie jest {ratio:.1f}x dłuższe niż źródło"

#: l10n_lint.py:489
#, python-brace-format
msgid "Warning: Could not fetch {path}: {error}"
msgstr "Ostrzeżenie: Nie można pobrać {path}: {error}"

#: l10n_lint.py:512
#, python-brace-format
msgid "✅ {count} file(s) checked, no issues found."
msgstr "✅ {count} sprawdzonych plików, nie znaleziono problemów."

#: l10n_lint.py:523
#, python-brace-format
msgid "  {icon} Line {line}: [{rule}] {message}"
msgstr "{icon} Linia {line}: [{rule}] {message}"

#: l10n_lint.py:527
#, python-brace-format
msgid "     Context: \"{context}...\""
msgstr "Kontekst: „{context}...”"

#: l10n_lint.py:529
#, python-brace-format
msgid "\n📊 Summary: {files} file(s), {errors} error(s), {warnings} warning(s)"
msgstr "\n📊 Podsumowanie: {files} plików, {errors} błędów, {warnings} ostrzeżeń"

#: l10n_lint.py:537
msgid "l10n-lint - Linter for localization files (.po, .ts)"
msgstr "l10n-lint - Linter do plików lokalizacyjnych (.po, .ts)"

#: l10n_lint.py:539
msgid "\nExamples:\n  l10n-lint ./translations/           # Lint local directory\n  l10n-lint file.po                   # Lint single file\n  l10n-lint --github owner/repo       # Lint GitHub repository\n  l10n-lint --github https://github.com/owner/repo --path resources/language/\n        "
msgstr "\nPrzykłady:\n  l10n-lint ./tłumaczenia/           # Katalog lokalny Lint\n  l10n-lint file.po                   # Lint pojedynczy plik\n  l10n-lint --github owner/repo       # repozytorium Lint GitHub\n  l10n-lint --github https://github.com/owner/repo --path resources/language/"

#: l10n_lint.py:548
msgid "Files or directories to lint"
msgstr "Pliki lub katalogi do kładzenia"

#: l10n_lint.py:549
msgid "GitHub repository (owner/repo or URL)"
msgstr "Repozytorium GitHub (właściciel/repozytorium lub adres URL)"

#: l10n_lint.py:550
msgid "Path filter for GitHub repos"
msgstr "Filtr ścieżek dla repozytoriów GitHub"

#: l10n_lint.py:551
msgid "Output format"
msgstr "Format wyjściowy"

#: l10n_lint.py:552
msgid "Max translation length (default: 500)"
msgstr "Maksymalna długość tłumaczenia (domyślnie: 500)"

#: l10n_lint.py:553
msgid "Don't search subdirectories"
msgstr "Nie szukaj w podkatalogach"

#: l10n_lint.py:554
msgid "Treat warnings as errors"
msgstr "Traktuj ostrzeżenia jako błędy"

#: l10n_lint.py:571
#, python-brace-format
msgid "🔍 Fetching from GitHub: {repo}"
msgstr "🔍 Pobieranie z GitHub: {repo}"

#: l10n_lint.py:574
#, python-brace-format
msgid "  Checking: {path}"
msgstr "Sprawdzanie: {path}"

#: l10n_lint.py:579
#, python-brace-format
msgid "❌ GitHub error: {error}"
msgstr "Błąd ❌ GitHub: {error}"
