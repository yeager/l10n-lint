msgid "Max translation length (default: 500)"
msgstr "Lunghezza massima di traduzione (predefinita: 500)"

#: l10n_lint.py:581
msgid "Don't search subdirectories"
msgstr "Non cercare nelle sottodirectory"

#: l10n_lint.py:582
