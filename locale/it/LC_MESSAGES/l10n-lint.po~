"\n"
"📊 Summary: {files} file(s), {errors} error(s), {warnings} warning(s)"
msgstr ""
"\n"
"📊 Riepilogo: {files} file, {errors} errori, {warnings} avvisi"

#: l10n_lint.py:565
msgid "l10n-lint - Linter for localization files (.po, .ts)"
msgstr "l10n-lint - Linter per file di localizzazione (.po, .ts)"

#: l10n_lint.py:567
msgid ""
"\n"
"Examples:\n"
"  l10n-lint ./translations/           # Lint local directory\n"
"  l10n-lint file.po                   # Lint single file\n"
"  l10n-lint --github owner/repo       # Lint GitHub repository\n"
"  l10n-lint --github https://github.com/owner/repo --path resources/"
"language/\n"
"        "
msgstr ""
"\n"
"Esempi:\n"
"  l10n-lint ./translations/           # Directory locale Lint\n"
"  l10n-lint file.po                   # Lint file singolo\n"
"  l10n-lint --github owner/repo       # Lint GitHub repository\n"
"  l10n-lint --github https://github.com/owner/repo --path risorse/lingua/"

#: l10n_lint.py:576
msgid "Files or directories to lint"
msgstr "File o directory da filettare"

#: l10n_lint.py:577
