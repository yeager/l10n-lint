#: l10n_lint.py:245
#, python-brace-format
msgid "Could not read file: {error}"
msgstr "Kan bestand niet lezen: {error}"

#: l10n_lint.py:262
#, python-brace-format
msgid "Unknown file format: {ext}"
msgstr "Onbekend bestandsformaat: {ext}"

#: l10n_lint.py:289
msgid "Missing translation (empty msgstr)"
msgstr "Ontbrekende vertaling (leeg msgstr)"

#: l10n_lint.py:300
msgid "Fuzzy translation needs review"
msgstr "Vage vertaling moet worden beoordeeld"

#: l10n_lint.py:319
#, python-brace-format
msgid "Duplicate msgid (first seen at line {line})"
msgstr "Dupliceer msgid (voor het eerst gezien op regel {line})"

#: l10n_lint.py:342
msgid "Unfinished/missing translation"
msgstr "Onvoltooide/ontbrekende vertaling"

#: l10n_lint.py:353
msgid "Vanished translation (source removed)"
msgstr "Verdwenen vertaling (bron verwijderd)"

#: l10n_lint.py:382
#, python-brace-format
msgid "Placeholder mismatch ({name}): source has {source}, translation has {trans}"
msgstr "Tijdelijke mismatch ({name}): bron heeft {source}, vertaling heeft {trans}"

#: l10n_lint.py:396
#, python-brace-format
msgid "Translation is very long ({length} chars, max {max})"
msgstr "De vertaling is erg lang ({length} tekens, max {max})"

#: l10n_lint.py:408
#, python-brace-format
msgid "Translation is {ratio:.1f}x longer than source"
msgstr "Vertaling is {ratio:.1f}x langer dan bron"

#: l10n_lint.py:489
#, python-brace-format
msgid "Warning: Could not fetch {path}: {error}"
msgstr "Waarschuwing: kan {path} niet ophalen: {error}"

#: l10n_lint.py:512
#, python-brace-format
msgid "✅ {count} file(s) checked, no issues found."
msgstr "✅ {count} bestand(en) gecontroleerd, geen problemen gevonden."

#: l10n_lint.py:523
#, python-brace-format
msgid "  {icon} Line {line}: [{rule}] {message}"
msgstr "{icon} Regel {line}: [{rule}] {message}"

#: l10n_lint.py:527
#, python-brace-format
msgid "     Context: \"{context}...\""
msgstr "Context: \"{context}...\""

#: l10n_lint.py:529
#, python-brace-format
msgid "\n📊 Summary: {files} file(s), {errors} error(s), {warnings} warning(s)"
msgstr "📊 Samenvatting: {files} bestand(en), {errors} fout(en), {warnings} waarschuwing(en)"

#: l10n_lint.py:537
msgid "l10n-lint - Linter for localization files (.po, .ts)"
msgstr "l10n-lint - Linter voor lokalisatiebestanden (.po, .ts)"

#: l10n_lint.py:539
msgid "\nExamples:\n  l10n-lint ./translations/           # Lint local directory\n  l10n-lint file.po                   # Lint single file\n  l10n-lint --github owner/repo       # Lint GitHub repository\n  l10n-lint --github https://github.com/owner/repo --path resources/language/\n        "
msgstr "Voorbeelden:\n  l10n-lint ./translations/           # Lint lokale directory\n  l10n-lint file.po                   # Lint enkel bestand\n  l10n-lint --github eigenaar/repo       # Lint GitHub opslagplaats\n  l10n-lint --github https://github.com/owner/repo --path resources/language/"

#: l10n_lint.py:548
msgid "Files or directories to lint"
msgstr "Bestanden of mappen om te pluizen"

#: l10n_lint.py:549
msgid "GitHub repository (owner/repo or URL)"
msgstr "GitHub-repository (eigenaar/repo of URL)"

#: l10n_lint.py:550
msgid "Path filter for GitHub repos"
msgstr "Padfilter voor GitHub-repo's"

#: l10n_lint.py:551
msgid "Output format"
msgstr "Uitvoer formaat"

#: l10n_lint.py:552
msgid "Max translation length (default: 500)"
msgstr "Maximale vertaallengte (standaard: 500)"

#: l10n_lint.py:553
msgid "Don't search subdirectories"
msgstr "Zoek niet in submappen"

#: l10n_lint.py:554
msgid "Treat warnings as errors"
msgstr "Waarschuwingen als fouten behandelen"

#: l10n_lint.py:571
#, python-brace-format
msgid "🔍 Fetching from GitHub: {repo}"
msgstr "🔍 Ophalen van GitHub: {repo}"

#: l10n_lint.py:574
#, python-brace-format
msgid "  Checking: {path}"
msgstr "Controleren: {path}"

#: l10n_lint.py:579
#, python-brace-format
msgid "❌ GitHub error: {error}"
msgstr "❌ GitHub-fout: {error}"
