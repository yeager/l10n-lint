<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.yeager.l10n-lint</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>l10n-lint</name>
  <summary>Linter for localization files with CLI and GTK interfaces</summary>

  <developer id="io.github.yeager">
    <name>Daniel Nylander</name>
  </developer>

  <description>
    <p>
      l10n-lint checks .po and .ts localization files for common errors such as
      missing translations, format string mismatches, inconsistent punctuation,
      and more. It provides both a command-line interface and a GTK graphical
      interface for convenient use.
    </p>
  </description>

  <launchable type="desktop-id">io.github.yeager.l10n-lint.desktop</launchable>

  <provides>
    <binary>l10n-lint</binary>
  </provides>

  <categories>
    <category>Development</category>
    <category>Translation</category>
  </categories>

  <keywords>
    <keyword>translation</keyword>
    <keyword>localization</keyword>
    <keyword>i18n</keyword>
    <keyword>l10n</keyword>
    <keyword>gettext</keyword>
    <keyword>PO</keyword>
    <keyword>TS</keyword>
    <keyword>linter</keyword>
  </keywords>

  <url type="homepage">https://github.com/yeager/l10n-lint</url>
  <url type="bugtracker">https://github.com/yeager/l10n-lint/issues</url>
  <url type="vcs-browser">https://github.com/yeager/l10n-lint</url>

  <releases>
    <release version="1.3.6" date="2026-02-04" />
    <release version="1.2.0" />
    <release version="1.1.0" />
  </releases>

  <content_rating type="oars-1.1" />
</component>
