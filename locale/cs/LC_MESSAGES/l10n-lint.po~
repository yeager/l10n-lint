#: l10n_lint.py:253
#, python-brace-format
msgid "Could not read file: {error}"
msgstr "Nelze přečíst soubor: {error}"

#: l10n_lint.py:270
#, python-brace-format
msgid "Unknown file format: {ext}"
msgstr "Neznámý formát souboru: {ext}"

#: l10n_lint.py:305 l10n_lint.py:316
msgid "Missing translation (empty msgstr)"
msgstr "Chybějící překlad (prázdná msgstr)"

#: l10n_lint.py:327
msgid "Fuzzy translation needs review"
msgstr "Fuzzy překlad potřebuje revizi"

#: l10n_lint.py:346
#, python-brace-format
msgid "Duplicate msgid (first seen at line {line})"
msgstr "Duplikovat msgstr (poprvé viděno na řádku {line})"

#: l10n_lint.py:369
msgid "Unfinished/missing translation"
msgstr "Nedokončený/chybějící překlad"

#: l10n_lint.py:380
msgid "Vanished translation (source removed)"
msgstr "Zmizelý překlad (zdroj byl odstraněn)"

#: l10n_lint.py:409
#, python-brace-format
msgid ""
"Placeholder mismatch ({name}): source has {source}, translation has {trans}"
msgstr ""
"Neshoda zástupného symbolu ({name}): zdroj má {source}, překlad {trans}"

#: l10n_lint.py:424
#, python-brace-format
msgid "Translation is very long ({length} chars, max {max})"
msgstr "Překlad je velmi dlouhý ({length} znaků, max. {max})"

#: l10n_lint.py:436
#, python-brace-format
msgid "Translation is {ratio:.1f}x longer than source"
msgstr "Překlad je {ratio:.1f}x delší než zdroj"

#: l10n_lint.py:517
#, python-brace-format
msgid "Warning: Could not fetch {path}: {error}"
msgstr "Varování: Nelze načíst {path}: {error}"

#: l10n_lint.py:540
#, python-brace-format
msgid "✅ {count} file(s) checked, no issues found."
msgstr ""
"Počet zkontrolovaných souborů: ✅ {count}, nebyly nalezeny žádné problémy."

#: l10n_lint.py:551
#, python-brace-format
msgid "  {icon} Line {line}: [{rule}] {message}"
msgstr "{icon} Řádek {line}: [{rule}] {message}"

#: l10n_lint.py:555
#, python-brace-format
msgid "     Context: \"{context}...\""
msgstr "Kontext: \"{context}...\""

#: l10n_lint.py:557
#, python-brace-format
msgid ""
"\n"
"📊 Summary: {files} file(s), {errors} error(s), {warnings} warning(s)"
msgstr ""
"\n"
"📊 Shrnutí: {files} soubor(y), {errors} chyba(y), {warnings} varování"

#: l10n_lint.py:565
msgid "l10n-lint - Linter for localization files (.po, .ts)"
msgstr "l10n-lint - Linter pro lokalizační soubory (.po, .ts)"

#: l10n_lint.py:567
msgid ""
"\n"
"Examples:\n"
"  l10n-lint ./translations/           # Lint local directory\n"
"  l10n-lint file.po                   # Lint single file\n"
"  l10n-lint --github owner/repo       # Lint GitHub repository\n"
"  l10n-lint --github https://github.com/owner/repo --path resources/"
"language/\n"
"        "
msgstr ""
"\n"
"Příklady:\n"
"  l10n-lint ./translations/           # Místní adresář Lint\n"
"  l10n-lint file.po                   # Lint jeden soubor\n"
"  l10n-lint --github vlastník/repo       # Lint GitHub repozitář\n"
"  l10n-lint --github https://github.com/owner/repo --path resources/language/"

#: l10n_lint.py:576
msgid "Files or directories to lint"
msgstr "Soubory nebo adresáře do Lint"

#: l10n_lint.py:577
msgid "GitHub repository (owner/repo or URL)"
msgstr "Repozitář GitHub (vlastník/repo nebo URL)"

#: l10n_lint.py:578
msgid "Path filter for GitHub repos"
msgstr "Filtr cest pro repo služby GitHub"

#: l10n_lint.py:579
msgid "Output format"
msgstr "Výstupní formát"

#: l10n_lint.py:580
msgid "Max translation length (default: 500)"
msgstr "Maximální délka překladu (výchozí: 500)"

#: l10n_lint.py:581
msgid "Don't search subdirectories"
msgstr "Nevyhledávat podadresáře"

#: l10n_lint.py:582
msgid "Treat warnings as errors"
msgstr "treat warnings as errors"

#: l10n_lint.py:599
#, python-brace-format
msgid "🔍 Fetching from GitHub: {repo}"
msgstr "🔍 Načítání z GitHubu: {repo}"

#: l10n_lint.py:602
#, python-brace-format
msgid "  Checking: {path}"
msgstr "Kontrola: {path}"

#: l10n_lint.py:607
#, python-brace-format
msgid "❌ GitHub error: {error}"
msgstr "Chyba ❌ GitHubu: {error}"
