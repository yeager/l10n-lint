#: l10n_lint_gtk.py:91
msgid "Missing translations"
msgstr "Saknade översättningar"

#: l10n_lint_gtk.py:91
msgid "Check for empty msgstr/unfinished translations"
msgstr "Kontrollera om det finns tomma msgstr/ofullständiga översättningar"

#: l10n_lint_gtk.py:92
msgid "Fuzzy entries"
msgstr "Luddiga poster"

#: l10n_lint_gtk.py:92
msgid "Flag entries marked as fuzzy/needs review"
msgstr "Flaggade poster markerade som luddiga/behöver granskas"

#: l10n_lint_gtk.py:93
