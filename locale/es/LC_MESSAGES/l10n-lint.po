#: l10n_lint.py:245
#, python-brace-format
msgid "Could not read file: {error}"
msgstr "No se ha podido leer el archivo: {error}"

#: l10n_lint.py:262
#, python-brace-format
msgid "Unknown file format: {ext}"
msgstr "Formato de archivo desconocido: {ext}"

#: l10n_lint.py:289
msgid "Missing translation (empty msgstr)"
msgstr "Falta traducción (msgstr vacío)"

#: l10n_lint.py:300
msgid "Fuzzy translation needs review"
msgstr "La traducción difusa necesita revisión"

#: l10n_lint.py:319
#, python-brace-format
msgid "Duplicate msgid (first seen at line {line})"
msgstr "Duplicado msgid (visto por primera vez en la línea {line})"

#: l10n_lint.py:342
msgid "Unfinished/missing translation"
msgstr "Traducción inacabada/faltante"

#: l10n_lint.py:353
msgid "Vanished translation (source removed)"
msgstr "Traducción desaparecida (fuente eliminada)"

#: l10n_lint.py:382
#, python-brace-format
msgid "Placeholder mismatch ({name}): source has {source}, translation has {trans}"
msgstr "El marcador de posición no coincide ({name}): la fuente tiene {source}, la traducción tiene {trans}"

#: l10n_lint.py:396
#, python-brace-format
msgid "Translation is very long ({length} chars, max {max})"
msgstr "La traducción es muy larga ({length} caracteres, máx. {max})"

#: l10n_lint.py:408
#, python-brace-format
msgid "Translation is {ratio:.1f}x longer than source"
msgstr "La traducción es {ratio:.1f}x más larga que la fuente"

#: l10n_lint.py:489
#, python-brace-format
msgid "Warning: Could not fetch {path}: {error}"
msgstr "Advertencia: No se ha podido obtener {path}: {error}"

#: l10n_lint.py:512
#, python-brace-format
msgid "✅ {count} file(s) checked, no issues found."
msgstr "✅ {count} archivo(s) comprobado (s), no se han encontrado problemas."

#: l10n_lint.py:523
#, python-brace-format
msgid "  {icon} Line {line}: [{rule}] {message}"
msgstr "{icon} Línea {line}: [{rule}] {message}"

#: l10n_lint.py:527
#, python-brace-format
msgid "     Context: \"{context}...\""
msgstr "Context context);"

#: l10n_lint.py:529
#, python-brace-format
msgid "\n📊 Summary: {files} file(s), {errors} error(s), {warnings} warning(s)"
msgstr "📊 Resumen: {files} archivo(s), {errors} error(es), {warnings} advertencia(s)"

#: l10n_lint.py:537
msgid "l10n-lint - Linter for localization files (.po, .ts)"
msgstr "l10n-lint - Linter para archivos de localización (.po, .ts)"

#: l10n_lint.py:539
msgid "\nExamples:\n  l10n-lint ./translations/           # Lint local directory\n  l10n-lint file.po                   # Lint single file\n  l10n-lint --github owner/repo       # Lint GitHub repository\n  l10n-lint --github https://github.com/owner/repo --path resources/language/\n        "
msgstr "Ejemplos:\n  l10n-lint ./translations/           # Directorio local de pelusa\n  l10n-lint file.po                   # Archivo único de pelusa\n  l10n-lint --github owner/repo       # Repositorio de GitHub de Lint\n  l10n-lint --github https://github.com/owner/repo --path recursos/idioma/"

#: l10n_lint.py:548
msgid "Files or directories to lint"
msgstr "Archivos o directorios para pelusa"

#: l10n_lint.py:549
msgid "GitHub repository (owner/repo or URL)"
msgstr "Repositorio de GitHub (propietario/repositorio o URL)"

#: l10n_lint.py:550
msgid "Path filter for GitHub repos"
msgstr "Filtro de ruta para repositorios de GitHub"

#: l10n_lint.py:551
msgid "Output format"
msgstr "Formato de salida "

#: l10n_lint.py:552
msgid "Max translation length (default: 500)"
msgstr "Longitud máxima de traslación (por defecto: 500)"

#: l10n_lint.py:553
msgid "Don't search subdirectories"
msgstr "No buscar subdirectorios"

#: l10n_lint.py:554
msgid "Treat warnings as errors"
msgstr "Tratar las advertencias como errores"

#: l10n_lint.py:571
#, python-brace-format
msgid "🔍 Fetching from GitHub: {repo}"
msgstr "🔍 Obteniendo de GitHub: {repo}"

#: l10n_lint.py:574
#, python-brace-format
msgid "  Checking: {path}"
msgstr "Comprobando: {path}"

#: l10n_lint.py:579
#, python-brace-format
msgid "❌ GitHub error: {error}"
msgstr "Error de ❌ GitHub: {error}"
