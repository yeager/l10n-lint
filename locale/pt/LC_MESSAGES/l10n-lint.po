#: l10n_lint.py:870
msgid "l10n-lint - Linter for localization files (.po, .ts)"
msgstr "l10n-lint - Linter para arquivos de localização (.po, .ts)"

#: l10n_lint.py:872
msgid ""
"\n"
"Examples:\n"
"  l10n-lint ./translations/           # Lint local directory\n"
"  l10n-lint file.po                   # Lint single file\n"
"  l10n-lint --github owner/repo       # Lint GitHub repository\n"
"  l10n-lint --github https://github.com/owner/repo --path resources/"
"language/\n"
"        "
msgstr ""
"\n"
"Exemplos:\n"
"  l10n-lint ./translations/           # Diretório local de fiapos\n"
"  l10n-lint file.po                   # Lint ficheiro único\n"
"  l10n-lint --github owner/repo       # Lint Repositório do GitHub\n"
"  l10n-lint --github https://github.com/owner/repo --path resources/language/"

